# Copy this file to .env and update the values as needed.
# Secrets such as the ngrok auth token should never be committed to Git.

# Public hostname used by n8n when generating webhook URLs.
# For local development without ngrok you can leave the default localhost value.
WEBHOOK_URL=http://localhost:5678/

# Hostname used by the n8n server.
N8N_HOST=n8n

# Optional basic authentication for the n8n editor UI.
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=admin

# Timezone used for cron nodes.
GENERIC_TIMEZONE=UTC

# ngrok configuration. Set NGROK_AUTHTOKEN to your personal token to enable tunnels.
# Leave NGROK_DOMAIN empty to let ngrok choose a random domain.
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
